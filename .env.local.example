# ──────────────────────────────────────────────────────────────────────────────
# Site
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ──────────────────────────────────────────────────────────────────────────────
# AI providers (required for AI features)
# ──────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GROQ_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Cloud / Supabase (Google sign-in + sync)
# ──────────────────────────────────────────────────────────────────────────────
# 1. Create project at https://supabase.com
# 2. Apply lib/supabase/schema.sql in SQL editor
# 3. Enable Google provider in Authentication → Providers
# 4. Add redirect URL: http://localhost:3000/auth/callback (and production URL)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set true to enable Google sign-in and cloud sync
NEXT_PUBLIC_USE_CLOUD=false
